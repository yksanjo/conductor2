{
  "name": "relationship-ops-nightly",
  "purpose": "Overnight relationship operations for a large contact base. Triage new replies, update per-person records, propose follow-ups from the state machine, and draft personalized messages into an approval batch. Never send, post, or change a suppression list. Output is a batch for the decision inbox.",
  "trigger": { "cron": "0 2 * * *" },
  "swarm": { "topology": "hierarchical", "size": 5 },
  "inputs": [
    { "name": "contact-ledger", "path": "ledger/contacts.jsonl" },
    { "name": "action-ledger", "path": "ledger/actions.jsonl" },
    { "name": "inbound-export", "path": "inbox/new-replies.jsonl" },
    { "name": "suppression-list", "path": "ledger/suppression.jsonl" },
    { "name": "campaign-config", "path": "campaigns/active.json" }
  ],
  "allowedOps": ["read", "research", "draft", "write-workspace"],
  "budget": { "minutes": 90, "tokens": 2000000 },
  "deliverable": {
    "file": "REPORT.md",
    "requiredSections": ["Summary", "Triage results", "Record updates", "Proposed follow-ups", "Drafts for approval", "Holds and exclusions", "Metrics"]
  },
  "verifier": { "sections": true },
  "retry": { "max": 1 },
  "escalate": { "to": "inbox" }
}
